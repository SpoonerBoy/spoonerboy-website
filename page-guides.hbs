{{!< default}}

{{!-- HERO — static theme chrome --}}
<section class="sb-page-hero" style="background:#0a1a0a">
  <div class="sb-hero-grid"></div>
  <div class="sb-hero-glow" style="background:radial-gradient(ellipse at 50% 0%, rgba(48,209,88,0.1) 0%, transparent 70%)"></div>
  <div class="sb-page-hero-inner">
    <div class="sb-eyebrow" style="background:rgba(48,209,88,0.08);border-color:rgba(48,209,88,0.25);color:var(--green)">
      <div class="sb-live-dot"></div>Server setup &middot; Minecraft &middot; Hosting
    </div>
    <h1 class="sb-page-title">{{#if title}}{{title}}{{else}}Server Setup Guides{{/if}}</h1>
    <p class="sb-page-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}Guides for players and server admins — host Minecraft at home, manage with AMP, and expose your server safely.{{/if}}</p>
  </div>
</section>

<hr class="sb-divider">

{{!-- BODY — managed in Ghost Admin --}}
{{#page}}
<div class="sb-page-content-wrap" style="max-width:1200px;padding-top:0">
  <div class="gh-content">
    {{content}}
  </div>
</div>
{{/page}}

<hr class="sb-divider">

{{!-- HOMELAB DOCS CALLOUT --}}
<div class="sb-docs-callout">
  <div class="sb-docs-callout-inner">
    <div class="sb-docs-callout-text">
      <div class="sb-docs-callout-label">Infrastructure docs</div>
      <div class="sb-docs-callout-title">Looking for Pi-hole, Proxmox, or networking guides?</div>
      <div class="sb-docs-callout-desc">Deep homelab documentation — network diagrams, configs, and runbooks — lives at homelabdocumented.com.</div>
    </div>
    <div class="sb-docs-callout-actions">
      <a class="sb-btn sb-btn-blue" href="https://homelabdocumented.com" target="_blank" rel="noopener">homelabdocumented.com ↗</a>
    </div>
  </div>
</div>

{{!< default}}

{{!-- HERO — Spoonerboy.com front and center, gaming creator brand --}}
<section class="sb-hero" style="background:#0a0a0f">
  <div class="sb-hero-grid"></div>
  <div class="sb-hero-glow" style="background:radial-gradient(ellipse at 50% 0%, rgba(48,209,88,0.1) 0%, transparent 70%)"></div>
  <div class="sb-hero-inner">
    <div class="sb-eyebrow" style="background:rgba(48,209,88,0.08);border-color:rgba(48,209,88,0.25);color:var(--green)">
      <div class="sb-live-dot"></div>Ohio &middot; Minecraft &middot; Community
    </div>
    <h1 class="sb-hero-title">Spoonerboy<span class="dim">.com</span></h1>
    <p class="sb-hero-sub">Creator, server owner, and community builder. SpoonerCraft SMP, modpacks, server updates, and guides for running your own game server at home.</p>
    <div class="sb-btn-row">
      <a class="sb-btn sb-btn-blue" href="{{@site.url}}/spoonercraft/">Join SpoonerCraft</a>
      <a class="sb-btn sb-btn-ghost" href="{{@site.url}}/mc-mods/">Get the modpack</a>
      <a class="sb-btn sb-btn-ghost" href="{{@site.url}}/guides/">Server guides</a>
    </div>
    <div class="sb-stat-row">
      <div class="sb-stat"><div class="sb-stat-val g" data-mc-count="online">—</div><div class="sb-stat-lbl">Players online</div></div>
      <div class="sb-stat"><div class="sb-stat-val" data-mc-count="max">—</div><div class="sb-stat-lbl">Max players</div></div>
      <div class="sb-stat"><div class="sb-stat-val g" data-mc-count="status">—</div><div class="sb-stat-lbl">Server status</div></div>
      <div class="sb-stat"><div class="sb-stat-val t">Fabric</div><div class="sb-stat-lbl">26.1.2</div></div>
    </div>
  </div>
</section>

<hr class="sb-divider">

{{!-- SPOONERCRAFT --}}
<div class="sb-section">
  <div class="sb-section-label sb-reveal">Minecraft</div>
  <div class="sb-line-reveal sb-reveal sb-reveal-d1"><span><h2 class="sb-section-title">SpoonerCraft SMP.</h2></span></div>
  <p class="sb-section-sub sb-reveal sb-reveal-d2">Whitelisted Fabric survival. Proximity voice chat, community events, and a curated modpack — self-hosted in Ohio.</p>
  <div class="sb-mc-panel sb-reveal sb-reveal-d3">
    <div class="sb-mc-top">
      <div>
        <h3>Join the server</h3>
        <p>Whitelist open — apply, install the modpack, and connect.</p>
        <div class="sb-ip-box">
          <code>playmc.spoonerboy.com</code>
          <button class="sb-copy-btn" data-copy="playmc.spoonerboy.com">Copy</button>
        </div>
      </div>
      <div style="text-align:right">
        <div class="sb-mc-count" data-mc-count="online">—</div>
        <div class="sb-mc-lbl">players online right now</div>
      </div>
    </div>
  </div>
  <div class="sb-mod-grid sb-reveal sb-reveal-d3" style="margin-top:20px;border-radius:14px;overflow:hidden">
    <div class="sb-mod"><div class="sb-mod-name">Simple Voice Chat</div><div class="sb-mod-desc">Proximity voice</div></div>
    <div class="sb-mod"><div class="sb-mod-name">JourneyMap</div><div class="sb-mod-desc">Live world map</div></div>
    <div class="sb-mod"><div class="sb-mod-name">Iris + Sodium</div><div class="sb-mod-desc">Shaders &amp; FPS</div></div>
    <div class="sb-mod"><div class="sb-mod-name">Fresh Animations</div><div class="sb-mod-desc">Resource pack</div></div>
  </div>
  <div class="sb-btn-row sb-reveal sb-reveal-d4" style="justify-content:flex-start;margin-top:20px;margin-bottom:0">
    <a class="sb-btn sb-btn-blue" href="{{@site.url}}/spoonercraft/">Server page</a>
    <a class="sb-btn sb-btn-ghost" href="{{@site.url}}/mc-mods/">Mods &amp; downloads</a>
    <a class="sb-btn sb-btn-ghost" href="https://forms.gle/Xbn5PfNaYGfu74DC6" target="_blank" rel="noopener">Apply to join</a>
  </div>
</div>

<hr class="sb-divider">

{{!-- WHAT'S NEW — posts tagged minecraft or server-update --}}
{{#get "posts" filter="tag:[minecraft,server-update]" limit="3" include="tags"}}
<div class="sb-section">
  <div class="sb-section-label sb-reveal">Updates</div>
  <div class="sb-line-reveal sb-reveal sb-reveal-d1"><span><h2 class="sb-section-title">What's new.</h2></span></div>
  <p class="sb-section-sub sb-reveal sb-reveal-d2">Modpack changes, server news, and Minecraft guides — tag posts <code class="sb-hl-tag-hint">minecraft</code> or <code class="sb-hl-tag-hint">server-update</code> to show here.</p>
  {{#if posts}}
  <div class="sb-post-grid sb-stagger sb-reveal sb-reveal-d3">
    {{#foreach posts}}
    <a class="sb-post-card" href="{{url}}">
      {{#if feature_image}}
        <img class="sb-post-img" src="{{feature_image}}" alt="{{title}}" loading="lazy">
      {{else}}
        <div class="sb-post-img-placeholder">⛏️</div>
      {{/if}}
      <div class="sb-post-body">
        {{#primary_tag}}<div class="sb-post-tag">{{name}}</div>{{/primary_tag}}
        <div class="sb-post-title">{{title}}</div>
        {{#if custom_excerpt}}
          <div class="sb-post-excerpt">{{custom_excerpt}}</div>
        {{else if excerpt}}
          <div class="sb-post-excerpt">{{excerpt words="24"}}</div>
        {{/if}}
        <div class="sb-post-meta">
          <span>{{date format="MMM D, YYYY"}}</span>
          <span>{{reading_time}}</span>
        </div>
      </div>
    </a>
    {{/foreach}}
  </div>
  {{else}}
  <div class="sb-hl-empty-state sb-reveal sb-reveal-d3">
    <div class="sb-hl-empty-icon">📰</div>
    <p class="sb-hl-empty-title">No gaming updates yet</p>
    <p class="sb-hl-empty-desc">Publish a post tagged <code class="sb-hl-tag-hint">minecraft</code> or <code class="sb-hl-tag-hint">server-update</code> and it will appear here.</p>
  </div>
  {{/if}}
</div>
<hr class="sb-divider">
{{/get}}

{{!-- COMMUNITY — Minecraft Reddit teaser --}}
<div class="sb-section">
  <div class="sb-section-label sb-reveal">Community</div>
  <div class="sb-line-reveal sb-reveal sb-reveal-d1"><span><h2 class="sb-section-title">From the Minecraft community.</h2></span></div>
  <p class="sb-section-sub sb-reveal sb-reveal-d2">Live posts from r/Minecraft, r/fabricmc, and r/admincraft — refreshed every visit.</p>
  <div class="sb-reddit-grid sb-reveal sb-reveal-d3" id="hp-reddit-teaser">
    <div style="padding:40px;text-align:center;color:var(--muted);font-family:'DM Mono',monospace;font-size:13px">Loading posts...</div>
  </div>
  <div class="sb-btn-row sb-reveal sb-reveal-d4" style="justify-content:flex-start;margin-top:20px;margin-bottom:0">
    <a class="sb-btn sb-btn-ghost" href="{{@site.url}}/community/">All community feeds &rarr;</a>
  </div>
</div>

<hr class="sb-divider">

{{!-- SERVER GUIDES TEASER --}}
<div class="sb-section">
  <div class="sb-section-label sb-reveal">Guides</div>
  <div class="sb-line-reveal sb-reveal sb-reveal-d1"><span><h2 class="sb-section-title">Server setup guides.</h2></span></div>
  <p class="sb-section-sub sb-reveal sb-reveal-d2">For players and server admins — host Minecraft at home, expose it safely, and manage with AMP.</p>
  <div class="sb-cards sb-stagger sb-reveal sb-reveal-d3">
    <a href="{{@site.url}}/minecraft-server/" class="sb-card sb-card-link">
      <div class="sb-card-icon gr">⛏️</div>

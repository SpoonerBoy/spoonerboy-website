{{!< default}}

<section class="sb-hero" style="min-height:80vh">
  <div class="sb-hero-grid"></div>
  <div class="sb-hero-inner">
    <div class="sb-eyebrow"><div class="sb-live-dot" style="background:var(--red)"></div>{{#if statusCode}}{{statusCode}}{{else}}Error{{/if}}</div>
    <h1 class="sb-hero-title" style="font-size:clamp(36px,6vw,72px)">
      {{#if statusCode}}{{statusCode}}{{else}}Oops{{/if}}<br>
      <span class="dim">{{#if message}}{{message}}{{else}}Something went wrong{{/if}}</span>
    </h1>
    <p class="sb-hero-sub">This page doesn't exist, or something broke. Probably my Pi rebooting.</p>
    <div class="sb-btn-row">
      <a class="sb-btn sb-btn-blue" href="{{@site.url}}/">Back to homepage</a>
      <a class="sb-btn sb-btn-ghost" href="{{@site.url}}/lab/">Check the lab status</a>
    </div>
  </div>
</section>
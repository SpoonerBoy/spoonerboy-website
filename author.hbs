{{!< default}}

{{#author}}
<section class="sb-page-hero {{#if cover_image}}sb-page-hero--image{{/if}}">
  <div class="sb-hero-grid"></div>
  {{#if cover_image}}
    <div class="sb-page-hero-bg" style="background-image:url('{{cover_image}}')"></div>
    <div class="sb-page-hero-overlay"></div>
  {{else}}
    <div class="sb-hero-glow"></div>
  {{/if}}
  <div class="sb-page-hero-inner">
    {{#if profile_image}}
      <img class="sb-author-avatar" src="{{profile_image}}" alt="{{name}}">
    {{/if}}
    <h1 class="sb-page-title">{{name}}</h1>
    {{#if bio}}
      <p class="sb-page-excerpt">{{bio}}</p>
    {{/if}}
    <div class="sb-page-meta" style="justify-content:center;margin-top:12px">
      {{#if website}}<a href="{{website}}" target="_blank" rel="noopener" style="color:var(--blue)">Website</a>{{/if}}
      {{#if twitter}}<a href="{{twitter_url}}" target="_blank" rel="noopener" style="color:var(--blue)">Twitter</a>{{/if}}
      {{#if facebook}}<a href="{{facebook_url}}" target="_blank" rel="noopener" style="color:var(--blue)">Facebook</a>{{/if}}
    </div>
    <div class="sb-page-meta" style="justify-content:center;margin-top:8px">
      <span>{{plural ../pagination.total empty='No posts yet' singular='% post' plural='% posts'}}</span>
    </div>
  </div>
</section>
{{/author}}

<hr class="sb-divider">

<div class="sb-section">
  <div class="sb-post-grid">
    {{#foreach posts}}
    <a class="sb-post-card" href="{{url}}">
      {{#if feature_image}}
        <img class="sb-post-img" src="{{feature_image}}" alt="{{title}}" loading="lazy">
      {{else}}
        <div class="sb-post-img-placeholder">📝</div>
      {{/if}}
      <div class="sb-post-body">
        {{#primary_tag}}<div class="sb-post-tag">{{name}}</div>{{/primary_tag}}
        <div class="sb-post-title">{{title}}</div>
        {{#if custom_excerpt}}<div class="sb-post-excerpt">{{custom_excerpt}}</div>{{/if}}
        <div class="sb-post-meta">
          <span>{{date format="MMM D, YYYY"}}</span>
          <span>{{reading_time}}</span>
        </div>
      </div>
    </a>
    {{/foreach}}
  </div>

  {{pagination}}
</div>

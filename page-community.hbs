{{!< default}}

{{!-- HERO — static theme chrome --}}
<section class="sb-hero" style="min-height:50vh">
  <div class="sb-hero-grid"></div>
  <div class="sb-hero-glow"></div>
  <div class="sb-hero-inner">
    <div class="sb-eyebrow"><div class="sb-live-dot"></div>Live from Reddit &middot; Updated on every visit</div>
    <h1 class="sb-hero-title">{{#if title}}{{title}}{{else}}Community<br><span class="dim">Feeds.</span>{{/if}}</h1>
    <p class="sb-hero-sub">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}Live posts from Minecraft, homelab, and networking communities — refreshed every visit.{{/if}}</p>
  </div>
</section>

<hr class="sb-divider">

{{!-- OPTIONAL INTRO — managed in Ghost Admin (leave blank to hide) --}}
{{#page}}
<div class="sb-page-content-wrap">
  <div class="gh-content">
    {{content}}
  </div>
</div>
{{/page}}

{{!-- LIVE REDDIT FEEDS — JS-driven --}}
<div class="sb-section">
  <div class="sb-section-label sb-reveal">Minecraft</div>
  <div class="sb-line-reveal sb-reveal"><span><h2 class="sb-section-title">Minecraft feeds.</h2></span></div>
  <p class="sb-section-sub">Common Minecraft subreddits — mods, servers, builds, and community news.</p>
  <div id="community-feed-minecraft"></div>
</div>

<hr class="sb-divider">

<div class="sb-section">
  <div class="sb-section-label sb-reveal">Homelab &amp; Networking</div>
  <div class="sb-line-reveal sb-reveal"><span><h2 class="sb-section-title">Infrastructure feeds.</h2></span></div>
  <div id="community-feed-homelab"></div>
</div>

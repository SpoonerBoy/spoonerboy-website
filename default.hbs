<!DOCTYPE html>
<html lang="{{@site.locale}}" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{meta_title}}</title>
  <link rel="canonical" href="{{canonical_url}}">

  {{!-- Open Graph --}}
  <meta property="og:site_name" content="{{@site.title}}">
  <meta property="og:type" content="{{#is "post"}}article{{else}}website{{/is}}">
  <meta property="og:title" content="{{meta_title}}">
  <meta property="og:description" content="{{meta_description}}">
  <meta property="og:url" content="{{canonical_url}}">
  <meta property="og:image" content="{{#if feature_image}}{{feature_image}}{{else}}https://spoonerboy.com/content/images/2026/04/spooner-boy-gif-try-1.png{{/if}}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{meta_title}}">
  <meta name="twitter:description" content="{{meta_description}}">
  <meta name="twitter:image" content="{{#if feature_image}}{{feature_image}}{{else}}https://spoonerboy.com/content/images/2026/04/spooner-boy-gif-try-1.png{{/if}}">

  {{!-- Ghost required meta --}}
  {{ghost_head}}

  {{!-- Fonts + CSS --}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{asset "built/index.css"}}">
  <script src="{{asset "built/index.js"}}" defer></script>

  {{!-- Apply theme before page renders to prevent flash --}}
  <script>
    (function() {
      var t = localStorage.getItem('sb-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body>

  {{!-- NAV --}}
  <nav class="sb-nav" id="sb-nav">
    <div class="sb-nav-inner">
      <a href="{{@site.url}}" class="sb-logo">{{@site.title}}</a>
      <div class="sb-nav-right">
        <div class="sb-links">
          <a href="{{@site.url}}/" class="sb-link">Home</a>
          <a href="{{@site.url}}/spoonercraft/" class="sb-link">SpoonerCraft</a>
          <a href="{{@site.url}}/mc-mods/" class="sb-link">MC Mods</a>
          <a href="{{@site.url}}/guides/" class="sb-link">Guides</a>
          <a href="{{@site.url}}/community/" class="sb-link">Community</a>
          <a href="{{@site.url}}/about/" class="sb-link">About</a>
          <a href="https://forms.gle/Xbn5PfNaYGfu74DC6" class="sb-link cta" target="_blank" rel="noopener">Apply to join</a>
        </div>
        <button class="sb-toggle" id="sb-toggle" title="Toggle theme">☀️</button>
      </div>
    </div>
  </nav>

  {{!-- PAGE CONTENT --}}
  {{{body}}}

  {{!-- FOOTER --}}
  <hr class="sb-divider">
  <footer class="sb-footer">
    <div class="sb-footer-links">
      <a href="https://github.com/SpoonerBoy" target="_blank" rel="noopener">GitHub</a>
      <a href="{{@site.url}}/rss/">RSS</a>
      <a href="{{@site.url}}/about/">About</a>
      <a href="{{@site.url}}/projects/">Projects</a>
      <a href="{{@site.url}}/guides/">Guides</a>
      <a href="{{@site.url}}/homelab/">Homelab</a>
      <a href="https://homelabdocumented.com" target="_blank" rel="noopener">Homelab.Documented</a>
      <a href="{{@site.url}}/spoonercraft/">SpoonerCraft</a>
      <a href="{{@site.url}}/mc-mods/">MC Mods</a>
      <a href="{{@site.url}}/community/">Community</a>
    </div>
    <div class="sb-footer-copy">&copy; {{date format="YYYY"}} Delbert &middot; Self-hosted on a Raspberry Pi &#x1F5A4;</div>
  </footer>

  {{!-- Ghost required --}}
  {{ghost_foot}}

</body>
</html>